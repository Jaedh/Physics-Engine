{
  "version": 4,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "ball-sim-debug",
      "displayName": "Ball Sim (Debug)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/.build/ball-sim-debug",
      "installDir": "${sourceDir}/apps/ball-sim/out/debug",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "ball-sim-release",
      "displayName": "Ball Sim (Release)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/.build/ball-sim-release",
      "installDir": "${sourceDir}/apps/ball-sim/out/release",
      "cacheVariables": { 
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    }
  ],
  "buildPresets": [
    { 
      "name": "ball-sim-debug", 
      "configurePreset": "ball-sim-debug",
      "configuration": "Debug"
    },
    { 
      "name": "ball-sim-release", 
      "configurePreset": "ball-sim-release",
      "configuration": "Release"
    }
  ]
}